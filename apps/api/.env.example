# Supabase: Project Settings -> Database -> Connection string (puerto 5432)
# Nota: sslmode=no-verify solo si tu red no valida la cadena de Supabase (TLS igualmente cifrado)
DATABASE_URL="postgresql://postgres.REFERENCIA:PASSWORD@aws-1-us-west-2.pooler.supabase.com:5432/postgres?sslmode=no-verify"
PORT=8000
JWT_SECRET="genera-un-secret-largo-y-aleatorio"
